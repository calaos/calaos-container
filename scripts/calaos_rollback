#!/bin/bash
#
# calaos_rollback - roll the root btrfs subvolume back to the snapshot the
# system was booted from (a grub-btrfs snapshot boot entry). Invoked with no
# arguments from the daemon (app/system.go).

set -euo pipefail

# shellcheck source=lib/calaos-common.sh
. /usr/lib/calaos/calaos-common.sh

trap 'die "Error on line $LINENO"' ERR

# grub_default_entry_paths <grub.cfg>
# Prints the kernel and initrd paths of the first boot entry, the default one.
grub_default_entry_paths() {
    awk '
        $1 == "linux" && NF > 1 { if (seen) exit; print $2; seen = 1; next }
        $1 == "initrd" && seen { for (i = 2; i <= NF; i++) print $i; exit }
        $1 == "}" && seen { exit }
    ' "$1"
}

dst="/mnt"
update_grub_timeout="10m"

# Find the btrfs device backing the /.snapshots mount. findmnt resolves the
# actual mount table (mountinfo), anchored on the exact target, instead of
# `mount | grep /.snapshots` whose unanchored regex ('.' matches any char)
# can match more than one mount line and yield a multi-word $rootdev.
rootdev="$(findmnt --noheadings --output SOURCE --target /.snapshots)" || true

# On a btrfs subvolume mount findmnt prints "/dev/vda3[/@/.snapshots]": the
# bracketed subvolume path is not a device and mount refuses it.
rootdev="${rootdev%%\[*}"

if [ -z "$rootdev" ]; then
    die "Snapshot btrfs device not found"
fi

# Check we are booted from a readonly btrfs snapshot: the root filesystem
# must be the overlay set up by grub-btrfs snapshot boot entries. Anchored
# on the "/" target instead of text-matching `mount | grep "rootfs.*overlay"`.
rootfstype="$(findmnt --noheadings --output FSTYPE --target /)" || true
if [ "$rootfstype" != "overlay" ]; then
    die "Not booted from a readonly btrfs snapshot"
fi

# Extract the snapshot number from the kernel command line
# (rootflags=subvol=@/.snapshots/N/snapshot on snapshot boot entries).
# shellcheck disable=SC2119 # no args intended: read the default /proc/cmdline
calaos_parse_cmdline
rootflags="$(calaos_cmdline_get rootflags)" || rootflags=""
snapNumber=""
if [ -n "$rootflags" ]; then
    snapNumber="$(calaos_snapshot_number_from_subvol "$rootflags")" || snapNumber=""
fi

# Validate before ever calling snapper: an empty/non-numeric snapNumber must
# never reach `snapper rollback`, which would otherwise run with an empty
# argument (equivalent to rolling back with no target) instead of failing.
if ! [[ "$snapNumber" =~ ^[0-9]+$ ]]; then
    die "Could not determine snapshot number from /proc/cmdline (rootflags=${rootflags:-<unset>})"
fi

# Everything mounted below $dst, unmounted in reverse order on any exit.
mounted=()
mnt() {
    mount "$@" || return
    mounted+=("${!#}")
}
unmount_all() {
    local i
    for ((i = ${#mounted[@]} - 1; i >= 0; i--)); do
        umount "${mounted[$i]}" || true
    done
    mounted=()
}
override=""
cleanup_rollback() {
    unmount_all
    [ -z "$override" ] || rm -f "$override"
}
register_cleanup cleanup_rollback

#mount temporary rootfs and snapshot subvolume to be able to use snapper
mnt -o noatime,compress=zstd "$rootdev" "$dst"
mnt -o noatime,compress=zstd,subvol=@/.snapshots "$rootdev" "$dst/.snapshots"

# grub.cfg must follow the new default subvolume (see below): check what that
# needs before snapper changes anything.
if ! btrfs subvolume list "$dst" | awk '$NF == "@/boot/grub" { found = 1 } END { exit !found }'; then
    die "No @/boot/grub subvolume: grub.cfg could not follow the rollback"
fi
if [ ! -x "$dst/.snapshots/$snapNumber/snapshot/usr/sbin/update-grub" ]; then
    die "Snapshot #$snapNumber has no update-grub: grub.cfg could not follow the rollback"
fi

fail_grub() {
    die "grub.cfg not updated after the rollback ($1): the normal boot still loads the previous root's kernel"
}

info "--> Rollback rootfs to snapshot #$snapNumber"
arch-chroot "$dst" snapper --no-dbus rollback "$snapNumber"
# From here the default subvolume has changed: every failure must say so, a
# blind retry would roll back once more.
trap 'fail_grub "command failed at line $LINENO"' ERR
arch-chroot "$dst" snapper --no-dbus list || warn "snapper list failed"

# grub.cfg names the kernel by its path in the old default subvolume
# (/@/.snapshots/N/snapshot/boot/...): once snapper cleans that snapshot up, the
# normal entry no longer boots. It is regenerated from the new default root.
unmount_all
mnt -o noatime,compress=zstd "$rootdev" "$dst"
newroot="$(btrfs subvolume get-default "$dst" | sed -n 's/^ID [0-9].* path //p')" || newroot=""
[ -n "$newroot" ] || fail_grub "new default subvolume unknown"

mnt -o noatime,compress=zstd,subvol=@/boot/grub "$rootdev" "$dst/boot/grub"
# Without the ESP grub/41_calaos-snapshot-boot leaves out the one-shot block.
if mountpoint -q /efi && [ -d "$dst/efi" ]; then
    mnt --bind /efi "$dst/efi"
fi
# grub-btrfs fails in a chroot (calaos_install disables it too). A bind mount
# keeps the root's config untouched; the daemon runs update-grub again at the
# next boot, from the marker, to bring the snapshot submenu back.
btrfscfg="$dst/etc/default/grub-btrfs/config"
if [ -f "$btrfscfg" ]; then
    override="$(mktemp)"
    { cat "$btrfscfg"; echo 'GRUB_BTRFS_DISABLE="true"'; } >"$override"
    mnt --bind "$override" "$btrfscfg"
fi

# Bounded here rather than by the daemon's kill, so that the mounts are undone
# and the message is readable. Keep below rollbackTimeout (app/snapshots.go).
# The environment covers a grub-btrfs installed without its config file.
info "--> Regenerate grub.cfg for $newroot"
rc=0
GRUB_BTRFS_DISABLE=true timeout --kill-after=30s "$update_grub_timeout" arch-chroot "$dst" update-grub || rc=$?
case "$rc" in
0) ;;
124 | 137) fail_grub "update-grub timed out after $update_grub_timeout" ;;
*) fail_grub "update-grub failed" ;;
esac

grubcfg="$dst/boot/grub/grub.cfg"
paths="$(grub_default_entry_paths "$grubcfg")" || paths=""
[ -n "$paths" ] || fail_grub "grub.cfg has no boot entry"
while read -r p; do
    case "$p" in
    "/$newroot/boot/"*) ;;
    *) fail_grub "the default grub entry loads $p, outside $newroot" ;;
    esac
done <<<"$paths"

# grub.cfg is right at this point: without the marker the snapshot submenu
# only comes back with the next update-grub.
marker="$dst/var/lib/calaos-container/grub-refresh"
{ mkdir -p "${marker%/*}" && : >"$marker"; } ||
    warn "Could not write $marker: the snapshot boot menu comes back at the next update-grub"
