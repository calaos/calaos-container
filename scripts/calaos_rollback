#!/bin/bash
#
# calaos_rollback - roll the root btrfs subvolume back to the snapshot the
# system was booted from (a grub-btrfs snapshot boot entry). Invoked with no
# arguments from the daemon (app/system.go).

set -euo pipefail

# shellcheck source=lib/calaos-common.sh
. /usr/lib/calaos/calaos-common.sh

trap 'die "Error on line $LINENO"' ERR

dst="/mnt"

# Find the btrfs device backing the /.snapshots mount. findmnt resolves the
# actual mount table (mountinfo), anchored on the exact target, instead of
# `mount | grep /.snapshots` whose unanchored regex ('.' matches any char)
# can match more than one mount line and yield a multi-word $rootdev.
rootdev="$(findmnt --noheadings --output SOURCE --target /.snapshots)" || true

if [ -z "$rootdev" ]; then
    die "Snapshot btrfs device not found"
fi

# Check we are booted from a readonly btrfs snapshot: the root filesystem
# must be the overlay set up by grub-btrfs snapshot boot entries. Anchored
# on the "/" target instead of text-matching `mount | grep "rootfs.*overlay"`.
rootfstype="$(findmnt --noheadings --output FSTYPE --target /)" || true
if [ "$rootfstype" != "overlay" ]; then
    die "Not booted from a readonly btrfs snapshot"
fi

# Extract the snapshot number from the kernel command line
# (rootflags=subvol=@/.snapshots/N/snapshot on snapshot boot entries).
# shellcheck disable=SC2119 # no args intended: read the default /proc/cmdline
calaos_parse_cmdline
rootflags="$(calaos_cmdline_get rootflags)" || rootflags=""
snapNumber=""
if [ -n "$rootflags" ]; then
    snapNumber="$(calaos_snapshot_number_from_subvol "$rootflags")" || snapNumber=""
fi

# Validate before ever calling snapper: an empty/non-numeric snapNumber must
# never reach `snapper rollback`, which would otherwise run with an empty
# argument (equivalent to rolling back with no target) instead of failing.
if ! [[ "$snapNumber" =~ ^[0-9]+$ ]]; then
    die "Could not determine snapshot number from /proc/cmdline (rootflags=${rootflags:-<unset>})"
fi

# Cleanup trap: make sure /mnt/.snapshots and /mnt end up unmounted even if
# a later step fails, instead of leaving them mounted behind a dead script.
cleanup_rollback_mounts() {
    if mountpoint -q "$dst/.snapshots" 2>/dev/null; then
        umount "$dst/.snapshots" || true
    fi
    if mountpoint -q "$dst" 2>/dev/null; then
        umount "$dst" || true
    fi
}
register_cleanup cleanup_rollback_mounts

#mount temporary rootfs and snapshot subvolume to be able to use snapper
mount -o noatime,compress=zstd "$rootdev" "$dst"
mount -o noatime,compress=zstd,subvol=@/.snapshots "$rootdev" "$dst/.snapshots"

info "--> Rollback rootfs to snapshot #$snapNumber"
arch-chroot "$dst" snapper --no-dbus rollback "$snapNumber"
arch-chroot "$dst" snapper --no-dbus list

umount "$dst/.snapshots"
umount "$dst"
