#!/bin/bash
#
# calaos_install - install Calaos-OS onto a disk.
#
# Usage: calaos_install [--dry-run] <destination_disk>
#
# DESTRUCTIVE: this script wipes the partition table of <destination_disk>,
# repartitions it and creates new filesystems on it. Every byte of the target
# disk is lost. Callers (the calaos-container daemon install endpoint and the
# boot TUI in config_calaos-boot) are expected to have obtained an explicit
# user confirmation first; the safety checks below are a last line of defence,
# not a replacement for that confirmation.
#
# Safety invariants enforced here, before the first destructive command:
#   - the argument must be an existing block device of type "disk" (a whole
#     disk, not a partition),
#   - it must not be the disk that carries the running root filesystem,
#   - it must not carry any mounted filesystem or active swap,
#   - every external tool needed by the whole run must already be installed,
#     so we never wipe a disk and then abort half way for a missing binary.
# With --dry-run all of the above is checked and the install plan printed, and
# the script exits before the first destructive command.
#
# On failure (or on any exit) the cleanup trap unmounts everything this script
# mounted and disables the swap it enabled, so an aborted run leaves no stray
# mounts or swap behind.
#

CALAOS_COMMON_LIB="/usr/lib/calaos/calaos-common.sh"
if [ ! -r "${CALAOS_COMMON_LIB}" ]; then
    echo "FATAL: required library ${CALAOS_COMMON_LIB} is missing or unreadable" >&2
    exit 1
fi
# shellcheck source=/dev/null
. "${CALAOS_COMMON_LIB}"

calaos_strict_mode  # set -euo pipefail
set -E              # make the ERR trap fire inside functions too

err_report() {
    err "Error on line $1 (command: ${BASH_COMMAND})"
}
trap 'err_report "${LINENO}"' ERR

# ---------------------------------------------------------------------------
# Global state (pre-initialised: the cleanup trap may run before they are set)
# ---------------------------------------------------------------------------

dry_run=0
destination=""
destination_esp=""
destination_swap=""
destination_rootfs=""
origin_rootfs=""
uuid_rootfs=""
uefi_mode=0
swap_enabled=0
dst="/mnt/destination_rootfs"
src="/mnt/origin_rootfs"

# Subvolumes created under @, in creation order. @ and @/.snapshots are created
# before these (the initial snapshot subvolume lives inside @/.snapshots).
btrfs_subvolumes=(
    boot/grub
    opt
    root
    srv
    tmp
    usr/local
    var/cache
    var/log
    var/spool
    var/tmp
)

# Subvolumes mounted under $dst, in mount order: the same list plus .snapshots.
# The mountpoint below $dst is the subvolume path with the leading "@/"
# stripped, so this single list drives the mountpoint creation and the mounts.
mount_subvolumes=(.snapshots "${btrfs_subvolumes[@]}")

# Marker delimiting the block this script appends to the installed /etc/fstab.
# Everything from the marker to the end of file is regenerated on every run,
# which keeps re-running the installer from duplicating fstab entries.
FSTAB_MARKER="# --- calaos_install: generated by genfstab, do not edit below ---"

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------

# unmount_tree <path>
# Recursively unmounts <path> and everything mounted below it, if it is a
# mountpoint at all. Never fails: falls back to a lazy unmount and finally
# gives up silently, so teardown can never abort mid-cleanup.
unmount_tree() {
    local target="${1:-}"

    [ -n "${target}" ] || return 0
    [ -d "${target}" ] || return 0
    mountpoint -q "${target}" 2>/dev/null || return 0

    umount -R "${target}" >/dev/null 2>&1 ||
        umount -R -l "${target}" >/dev/null 2>&1 ||
        warn "Could not unmount ${target}"

    return 0
}

# calaos_install_cleanup
# Registered with register_cleanup(), so it runs on every exit path: success,
# die(), a set -e abort or a signal. Idempotent - the normal end of the install
# calls it explicitly and the trap then finds nothing left to do.
calaos_install_cleanup() {
    if [ "${swap_enabled}" -eq 1 ] && [ -n "${destination_swap}" ]; then
        swapoff "${destination_swap}" >/dev/null 2>&1 ||
            warn "Could not disable swap on ${destination_swap}"
        swap_enabled=0
    fi

    unmount_tree "${src}"
    unmount_tree "${dst}"

    sync || true

    return 0
}
register_cleanup calaos_install_cleanup

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

usage() {
    echo "Usage: $0 [--dry-run] <destination_disk>"
    echo
    echo "  --dry-run   run every safety check and print the install plan,"
    echo "              then exit without touching the disk"
}

# require_commands <cmd>...
# Aborts unless every listed command is available on PATH.
require_commands() {
    local cmd
    local missing=()

    for cmd in "$@"; do
        command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
    done

    if [ "${#missing[@]}" -ne 0 ]; then
        die "Missing required command(s): ${missing[*]}"
    fi
}

# get_dev_part_count <disk>
# Prints the number of partitions of <disk> as reported by lsblk.
get_dev_part_count() {
    lsblk --json "$1" | jq -r ".blockdevices[0].children | length"
}

# get_dev_part <disk> <partnum>
# Prints the kernel name (e.g. "sda1") of the <partnum>-th partition (1-based)
# of <disk>, as reported by lsblk. Prints "null" when there is no such
# partition - callers must validate, see resolve_part().
get_dev_part() {
    local part="$2"
    lsblk --json "$1" | jq -r ".blockdevices[0].children[$((part - 1))].name"
}

# resolve_part <disk> <partnum>
# Prints the full path of partition <partnum> of <disk>, after checking that
# lsblk actually reported a partition and that the resulting path is a block
# device. Aborts otherwise, so a null lookup can never turn into a bare "/dev/"
# being handed to mkfs. Waits (bounded) for udev to create the node, which may
# lag slightly behind the parted call that created the partition.
resolve_part() {
    local disk="$1" num="$2"
    local name path i

    name="$(get_dev_part "${disk}" "${num}")"
    if [ -z "${name}" ] || [ "${name}" = "null" ]; then
        die "Could not resolve partition ${num} of ${disk}: lsblk reported no such partition"
    fi

    path="/dev/${name}"
    for (( i = 0; i < 20; i++ )); do
        if [ -b "${path}" ]; then
            break
        fi
        sleep 0.5
    done

    if [ ! -b "${path}" ]; then
        die "Partition ${num} of ${disk} resolves to ${path}, which is not a block device"
    fi

    printf '%s' "${path}"
}

# settle_devices
# Waits for pending udev events (partition node creation) when udevadm is
# available. Best effort: never fails the install.
settle_devices() {
    if command -v udevadm >/dev/null 2>&1; then
        udevadm settle >/dev/null 2>&1 || true
    fi
}

# sed_required <expression> <file>
# In-place sed on a file that must exist; aborts if it does not.
sed_required() {
    local expression="$1" file="$2"

    [ -f "${file}" ] || die "Cannot patch ${file}: file not found in the installed system"
    sed -i "${expression}" "${file}" || die "Failed to patch ${file}"
}

# sed_optional <expression> <file>
# In-place sed on a file that may legitimately be absent (e.g. the Xen grub
# snippet on systems without Xen); warns and skips instead of aborting.
sed_optional() {
    local expression="$1" file="$2"

    if [ -f "${file}" ]; then
        sed -i "${expression}" "${file}" || die "Failed to patch ${file}"
    else
        warn "Skipping ${file}: not present in the installed system"
    fi
}

# podman_export <container_name> <image> <root>
# Saves <image> as an oci-archive into <root>/var/lib/cache/containers/.
podman_export() {
    local container_name="$1"
    local image="$2"
    local dest="$3/var/lib/cache/containers"

    mkdir -p "${dest}" || die "Failed to create ${dest}"

    echo " -> Export image: ${container_name} (${image})"

    podman save --format oci-archive -o "${dest}/${container_name}.tar" "${image}" ||
        die "Failed to export container image ${image} to ${dest}/${container_name}.tar"
}

# ---------------------------------------------------------------------------
# Install steps
# ---------------------------------------------------------------------------

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run)
                dry_run=1
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                usage >&2
                die "Unknown option: $1"
                ;;
            *)
                break
                ;;
        esac
    done

    if [ $# -ne 1 ]; then
        usage >&2
        die "No valid disk argument given. Usage: $0 /dev/xxx"
    fi

    destination="$1"
}

# validate_target_is_whole_disk
# The target must be a whole disk, not a partition: partitioning a partition
# would silently destroy its parent's layout.
validate_target_is_whole_disk() {
    local dev_type

    dev_type="$(lsblk -dno TYPE "${destination}" 2>/dev/null | head -n1 || true)"
    if [ "${dev_type}" != "disk" ]; then
        die "Refusing to install on ${destination}: not a whole disk (type=${dev_type:-unknown}). Pass a disk such as /dev/sda."
    fi
}

# validate_target_not_origin
# Determines the device holding the running root filesystem (used later to copy
# it over) and refuses to install onto it, or onto the disk it belongs to.
validate_target_not_origin() {
    local origin_parent

    origin_rootfs="$(mount | grep "on / " | cut -d ' ' -f1 || true)"
    if [ -z "${origin_rootfs}" ]; then
        die "Could not determine the device holding the running root filesystem"
    fi

    if [ "${origin_rootfs}" = "${destination}" ]; then
        die "Can't install on same disk as source"
    fi

    # The check above only catches an exact match; the running rootfs is
    # normally a *partition* of a disk, so also refuse the disk holding it.
    origin_parent="$(lsblk -no PKNAME "${origin_rootfs}" 2>/dev/null | head -n1 || true)"
    if [ -n "${origin_parent}" ] && [ "/dev/${origin_parent}" = "${destination}" ]; then
        die "Can't install on same disk as source: ${destination} holds the running root filesystem (${origin_rootfs})"
    fi
}

# validate_target_not_in_use
# Anything mounted (or swapped on) from the target means the disk is in use -
# wiping it would corrupt a live filesystem, possibly the live medium this
# installer is running from.
validate_target_not_in_use() {
    local mounted

    mounted="$(lsblk -nro MOUNTPOINT "${destination}" 2>/dev/null | grep -v '^$' | tr '\n' ' ' || true)"
    if [ -n "${mounted}" ]; then
        die "Refusing to install on ${destination}: it is in use (mounted at: ${mounted}). Unmount it first."
    fi
}

# validate_target
# Every check that must pass before the disk may be touched.
validate_target() {
    if [ ! -b "${destination}" ]; then
        die "No valid disk argument given. Usage: $0 /dev/xxx"
    fi

    validate_target_is_whole_disk
    validate_target_not_origin
    validate_target_not_in_use
}

# detect_install_mode
# UEFI when the live medium booted with LABEL=live-efi on the kernel command
# line, BIOS otherwise (including when no LABEL is present at all, which is
# what the previous implementation ended up doing as well).
detect_install_mode() {
    local label

    calaos_parse_cmdline
    label="$(calaos_cmdline_get LABEL || true)"

    if [ "${label}" = "live-efi" ]; then
        uefi_mode=1
        info "--> Install in UEFI mode"
    else
        uefi_mode=0
        if [ -z "${label}" ]; then
            warn "No LABEL= on the kernel command line, assuming BIOS mode"
        fi
        info "--> Install in BIOS mode"
    fi
}

# preflight_checks
# Fail before the disk is touched rather than half way through the install.
preflight_checks() {
    require_commands arch-chroot awk blkid btrfs chattr chmod dd genfstab jq \
        lsblk mkswap mktemp mount mountpoint parted podman rsync sed swapon \
        systemd-escape umount

    if [ "${uefi_mode}" -eq 1 ]; then
        require_commands mkfs.vfat
    fi

    require_commands mkfs.btrfs
}

print_plan() {
    info "--> Installing on disk ${destination}"

    if [ "${uefi_mode}" -eq 1 ]; then
        info "    GPT layout: 1=efi (fat32, 512MiB) 2=swap (2GiB) 3=calaos (btrfs, rest)"
    else
        info "    MBR layout: 1=swap (2GiB) 2=calaos (btrfs, rest)"
    fi

    info "    Live root filesystem: ${origin_rootfs} (left untouched)"
}

wipe_partition_table() {
    info "--> Deleting partition table on ${destination}"
    dd if=/dev/zero of="${destination}" bs=512 count=35 > /dev/null ||
        die "Failed to wipe the partition table on ${destination}"
}

partition_disk() {
    if [ "${uefi_mode}" -eq 1 ]; then
        info "--> Creating GPT partition table"
        parted -s "${destination}" mklabel gpt > /dev/null ||
            die "Failed to create the GPT partition table on ${destination}"
        parted -s "${destination}" mkpart "efi" fat32 1MiB 513MiB > /dev/null ||
            die "Failed to create the efi partition on ${destination}"
        parted -s "${destination}" mkpart "swap" linux-swap 513MiB 2.5GiB > /dev/null ||
            die "Failed to create the swap partition on ${destination}"
        parted -s "${destination}" mkpart "calaos" ext4 2.5GiB 100% > /dev/null ||
            die "Failed to create the calaos partition on ${destination}"
        parted -s "${destination}" set 1 esp on > /dev/null ||
            die "Failed to set the esp flag on ${destination}"
        parted -s "${destination}" set 2 boot on > /dev/null ||
            die "Failed to set the boot flag on ${destination}"
    else
        info "--> Creating Bios partition table"
        parted -s "${destination}" mklabel msdos > /dev/null ||
            die "Failed to create the msdos partition table on ${destination}"
        parted -s "${destination}" mkpart primary linux-swap 1MiB 2049MiB > /dev/null ||
            die "Failed to create the swap partition on ${destination}"
        parted -s "${destination}" mkpart primary ext4 2049MiB 100% > /dev/null ||
            die "Failed to create the calaos partition on ${destination}"
        parted -s "${destination}" set 2 boot on > /dev/null ||
            die "Failed to set the boot flag on ${destination}"
    fi

    parted -s "${destination}" print || true
}

resolve_partitions() {
    local expected part_count

    settle_devices

    if [ "${uefi_mode}" -eq 1 ]; then
        expected=3
    else
        expected=2
    fi

    part_count="$(get_dev_part_count "${destination}" || true)"
    if [ "${part_count}" != "${expected}" ]; then
        die "Expected ${expected} partitions on ${destination} after partitioning, lsblk reports ${part_count:-none}"
    fi

    if [ "${uefi_mode}" -eq 1 ]; then
        destination_esp="$(resolve_part "${destination}" 1)"
        destination_swap="$(resolve_part "${destination}" 2)"
        destination_rootfs="$(resolve_part "${destination}" 3)"
    else
        destination_esp=""
        destination_swap="$(resolve_part "${destination}" 1)"
        destination_rootfs="$(resolve_part "${destination}" 2)"
    fi
}

format_partitions() {
    info "--> Formating partitions"

    if [ "${uefi_mode}" -eq 1 ]; then
        mkfs.vfat -F32 "${destination_esp}" > /dev/null ||
            die "Failed to format the efi partition ${destination_esp}"
    fi

    mkswap "${destination_swap}" ||
        die "Failed to format the swap partition ${destination_swap}"
    mkfs.btrfs --force --label "calaos-os" "${destination_rootfs}" ||
        die "Failed to format the root partition ${destination_rootfs}"

    uuid_rootfs="$(blkid -s PARTUUID -o value "${destination_rootfs}" || true)"
    if [ -z "${uuid_rootfs}" ]; then
        die "Could not read the PARTUUID of ${destination_rootfs}"
    fi
}

create_btrfs_layout() {
    local subvol subvol_id

    info "--> Create BTRFS filesystem"
    mkdir -p "${dst}" || die "Failed to create ${dst}"
    mount "${destination_rootfs}" "${dst}" ||
        die "Failed to mount ${destination_rootfs} on ${dst}"

    btrfs subvolume create "${dst}/@" || die "Failed to create subvolume @"
    btrfs subvolume create "${dst}/@/.snapshots" || die "Failed to create subvolume @/.snapshots"

    # Subvolume for the initial snapshot, which is the target of the install.
    mkdir "${dst}/@/.snapshots/1" || die "Failed to create ${dst}/@/.snapshots/1"

    mkdir "${dst}/@/boot" "${dst}/@/usr" "${dst}/@/var" ||
        die "Failed to create the base directories under ${dst}/@"

    btrfs subvolume create "${dst}/@/.snapshots/1/snapshot" ||
        die "Failed to create subvolume @/.snapshots/1/snapshot"

    for subvol in "${btrfs_subvolumes[@]}"; do
        btrfs subvolume create "${dst}/@/${subvol}" ||
            die "Failed to create subvolume @/${subvol}"
    done

    # Snapper stores per-snapshot metadata in /@/.snapshots/<num>/info.xml.
    cat > "${dst}/@/.snapshots/1/info.xml" <<EOF
<?xml version="1.0"?>
<snapshot>
	<type>single</type>
	<num>1</num>
	<date>$(date +"%Y-%m-%d %H:%M:%S")</date>
	<description>First Root Filesystem Created at Installation</description>
</snapshot>
EOF

    # Make the initial snapshot subvolume the default one. The id is read from
    # the "ID <n> gen ... path <path>" listing, matching the path field exactly
    # rather than grepping the whole line.
    subvol_id="$(btrfs subvolume list "${dst}" |
        awk '$NF == "@/.snapshots/1/snapshot" { print $2; exit }' || true)"
    if [ -z "${subvol_id}" ]; then
        die "Could not find the subvolume id of @/.snapshots/1/snapshot"
    fi

    btrfs subvolume set-default "${subvol_id}" "${dst}" ||
        die "Failed to set subvolume ${subvol_id} as default"
    btrfs subvolume get-default "${dst}"

    # Disable CoW for /var subvolumes.
    for subvol in cache log spool tmp; do
        chattr +C "${dst}/@/var/${subvol}" ||
            die "Failed to disable CoW on ${dst}/@/var/${subvol}"
    done

    btrfs subvolume list "${dst}"

    # Unmount and remount properly with the final mount options.
    umount "${dst}" || die "Failed to unmount ${dst}"
    mount -o noatime,compress=zstd "${destination_rootfs}" "${dst}" ||
        die "Failed to remount ${destination_rootfs} on ${dst}"
}

mount_subvolumes() {
    local subvol
    local mountpoints=()

    for subvol in "${mount_subvolumes[@]}"; do
        mountpoints+=("${dst}/${subvol}")
    done

    mkdir -p "${mountpoints[@]}" || die "Failed to create the subvolume mountpoints"

    for subvol in "${mount_subvolumes[@]}"; do
        mount -o "noatime,compress=zstd,subvol=@/${subvol}" "${destination_rootfs}" "${dst}/${subvol}" ||
            die "Failed to mount subvolume @/${subvol} on ${dst}/${subvol}"
    done

    if [ "${uefi_mode}" -eq 1 ]; then
        mkdir -p "${dst}/efi" || die "Failed to create ${dst}/efi"
        mount "${destination_esp}" "${dst}/efi" ||
            die "Failed to mount ${destination_esp} on ${dst}/efi"
    fi
}

enable_swap() {
    swapon "${destination_swap}" || die "Failed to enable swap on ${destination_swap}"
    swap_enabled=1
}

copy_rootfs() {
    info "--> Copy rootfs from live usb"

    mkdir -p "${src}" || die "Failed to create ${src}"
    mount "${origin_rootfs}" "${src}" ||
        die "Failed to mount ${origin_rootfs} on ${src}"

    rsync -avh "${src}/" "${dst}" \
        --exclude /.calaos-live \
        --exclude /tmp \
        --exclude /run \
        --exclude /dev \
        --exclude /proc \
        --exclude /sys \
        --exclude /var/run/containers \
        --exclude /var/run \
        --exclude /media \
        --exclude /mnt/destination_rootfs \
        --exclude /mnt/origin_rootfs \
        --exclude /var/lib/containers/storage/overlay \
        --exclude /var/lib/containers ||
        die "Failed to copy the root filesystem from ${src} to ${dst}"

    # Initramfs scripts of the live medium are not needed once installed.
    rm -rf "${dst}/.calaos-live" \
        "${dst}/etc/calaos-resize" \
        "${dst}/usr/share/initramfs-tools/hooks/resizeroot" \
        "${dst}/usr/share/initramfs-tools/scripts/local-bottom/resizeroot" ||
        die "Failed to remove the live-only files from ${dst}"
}

# generate_fstab
# Appends the generated fstab entries once, below a marker line. Any previously
# generated block (marker to end of file) is dropped first, so re-running the
# installer never duplicates entries. The new file is built next to the target
# and moved into place.
generate_fstab() {
    local fstab="${dst}/etc/fstab"
    local tmp_fstab

    tmp_fstab="$(mktemp "${fstab}.XXXXXX")" || die "Failed to create a temporary fstab"

    if [ -f "${fstab}" ]; then
        awk -v marker="${FSTAB_MARKER}" '$0 == marker { exit } { print }' "${fstab}" > "${tmp_fstab}" ||
            die "Failed to read the existing ${fstab}"
    fi

    printf '%s\n' "${FSTAB_MARKER}" >> "${tmp_fstab}" || die "Failed to write ${tmp_fstab}"
    genfstab -U "${dst}" >> "${tmp_fstab}" || die "genfstab failed for ${dst}"

    chmod 644 "${tmp_fstab}" || die "Failed to set the mode of ${tmp_fstab}"
    mv "${tmp_fstab}" "${fstab}" || die "Failed to install ${fstab}"

    mkdir -p "${dst}/tmp" "${dst}/run" "${dst}/dev" "${dst}/proc" "${dst}/sys" \
        "${dst}/var/run/containers" "${dst}/media" ||
        die "Failed to create the runtime directories in ${dst}"

    cat "${fstab}"
}

patch_grub_scripts() {
    # Fix grub with BTRFS so it uses /@/.snapshots/1/snapshot/boot instead of
    # /@/boot. 20_linux_xen is absent on systems without Xen - skip it there.
    # shellcheck disable=SC2016
    sed_optional 's/rootflags=subvol=${rootsubvol}//g' "${dst}/etc/grub.d/10_linux"
    # shellcheck disable=SC2016
    sed_optional 's/rootflags=subvol=${rootsubvol}//g' "${dst}/etc/grub.d/20_linux_xen"
}

regen_initramfs() {
    arch-chroot "${dst}" update-initramfs -u ||
        die "Failed to regenerate the initramfs in ${dst}"
}

export_container_images() {
    local file container_name

    info "--> Exporting container images"

    for file in /usr/share/calaos/*.source; do
        [ -e "${file}" ] || continue

        container_name="$(basename "${file}" .source)"

        IMAGE_SRC=""
        # shellcheck source=/dev/null
        . "${file}" || die "Failed to read the image definition ${file}"

        if [ -z "${IMAGE_SRC}" ]; then
            die "${file} does not define IMAGE_SRC"
        fi

        if calaos_image_exists "${IMAGE_SRC}"; then
            podman_export "${container_name}" "${IMAGE_SRC}" "${dst}"
        elif [ -e "/var/lib/cache/containers/${container_name}.tar" ]; then
            info "Image ${IMAGE_SRC} not found in local repository, copying it from cache"
            mkdir -p "${dst}/var/lib/cache/containers" ||
                die "Failed to create ${dst}/var/lib/cache/containers"
            rsync -avh "/var/lib/cache/containers/${container_name}.tar" \
                "${dst}/var/lib/cache/containers/" ||
                die "Failed to copy the cached image ${container_name}.tar"
        else
            info "Image ${IMAGE_SRC} not found in local repository, trying to pull it..."

            podman pull "${IMAGE_SRC}" ||
                die "Failed to pull container image ${IMAGE_SRC} required by ${file}"

            if ! calaos_image_exists "${IMAGE_SRC}"; then
                die "Container image ${IMAGE_SRC} is still missing after pulling it"
            fi

            podman_export "${container_name}" "${IMAGE_SRC}" "${dst}"
        fi
    done
}

# init_snapper
# Snapper refuses to create its config when .snapshots already exists, so the
# predefined subvolume is unmounted and removed, snapper is let to recreate it,
# its version is deleted and ours is mounted back.
init_snapper() {
    info "--> Initializing Snapper"

    umount "${dst}/.snapshots" || die "Failed to unmount ${dst}/.snapshots"
    rm -r "${dst}/.snapshots" || die "Failed to remove ${dst}/.snapshots"

    arch-chroot "${dst}" snapper --no-dbus -c root create-config / ||
        die "Failed to create the snapper root config"

    btrfs subvolume list "${dst}"
    btrfs subvolume delete "${dst}/.snapshots" ||
        die "Failed to delete the snapper-created ${dst}/.snapshots subvolume"

    mkdir -p "${dst}/.snapshots" || die "Failed to create ${dst}/.snapshots"
    mount -o noatime,compress=zstd,subvol=@/.snapshots "${destination_rootfs}" "${dst}/.snapshots" ||
        die "Failed to mount @/.snapshots on ${dst}/.snapshots"
    chmod 750 "${dst}/.snapshots" || die "Failed to set the mode of ${dst}/.snapshots"
}

install_bootloader() {
    info "--> Install Bootloader"

    if [ "${uefi_mode}" -eq 1 ]; then
        # --removable installs the UEFI payload in /EFI/BOOT/BOOTX64.EFI, which
        # buggy firmwares need.
        arch-chroot "${dst}" grub-install --target=x86_64-efi \
            --efi-directory=/efi \
            --bootloader-id=Calaos-OS \
            --removable \
            --modules="normal test efi_gop efi_uga search echo linux all_video gfxmenu gfxterm_background gfxterm_menu gfxterm loadenv configfile gzio part_gpt btrfs" ||
            die "Failed to install the UEFI bootloader"
    else
        arch-chroot "${dst}" grub-install --target=i386-pc "${destination}" ||
            die "Failed to install the BIOS bootloader on ${destination}"
    fi
}

configure_grub() {
    # The default 5s boot menu timeout is kept on purpose, so the user can pick
    # a snapshot if there is any.
    sed_required 's/^GRUB_DISTRIBUTOR=.*$/GRUB_DISTRIBUTOR="Calaos OS"/g' "${dst}/etc/default/grub"
    sed_required 's/^.*GRUB_COLOR_NORMAL=.*$/GRUB_COLOR_NORMAL="light-blue\/black"/g' "${dst}/etc/default/grub"
    sed_required 's/^.*GRUB_COLOR_HIGHLIGHT=.*$/GRUB_COLOR_HIGHLIGHT="white\/blue"/g' "${dst}/etc/default/grub"

    # grub-btrfs does not work inside the chroot, so it is disabled while
    # update-grub runs and enabled again right after.
    sed_required 's/^#*GRUB_BTRFS_DISABLE=.*$/GRUB_BTRFS_DISABLE="true"/g' "${dst}/etc/default/grub-btrfs/config"

    arch-chroot "${dst}" update-grub || die "Failed to generate the grub configuration"

    sed_required 's/^#*GRUB_BTRFS_DISABLE=.*$/GRUB_BTRFS_DISABLE="false"/g' "${dst}/etc/default/grub-btrfs/config"
}

enable_services() {
    local scrub_timer

    info "--> Enable services"

    scrub_timer="$(systemd-escape --template btrfs-scrub@.timer \
        --path "/dev/disk/by-partuuid/${uuid_rootfs}" || true)"
    if [ -z "${scrub_timer}" ]; then
        die "Could not build the btrfs-scrub timer unit name for PARTUUID ${uuid_rootfs}"
    fi

    arch-chroot "${dst}" systemctl enable \
        fstrim.timer \
        "${scrub_timer}" \
        snapper-timeline.timer \
        snapper-cleanup.timer \
        grub-btrfsd.service ||
        die "Failed to enable the system services"

    arch-chroot "${dst}" snapper --no-dbus -c root set-config "NUMBER_LIMIT=10" ||
        die "Failed to configure snapper (NUMBER_LIMIT)"
    arch-chroot "${dst}" snapper --no-dbus -c root set-config "NUMBER_MIN_AGE=5400" ||
        die "Failed to configure snapper (NUMBER_MIN_AGE)"
    arch-chroot "${dst}" snapper --no-dbus -c root set-config "TIMELINE_LIMIT_DAILY=14" ||
        die "Failed to configure snapper (TIMELINE_LIMIT_DAILY)"
    arch-chroot "${dst}" snapper --no-dbus -c root set-config "TIMELINE_LIMIT_WEEKLY=4" ||
        die "Failed to configure snapper (TIMELINE_LIMIT_WEEKLY)"
    arch-chroot "${dst}" snapper --no-dbus -c root set-config "TIMELINE_LIMIT_MONTHLY=6" ||
        die "Failed to configure snapper (TIMELINE_LIMIT_MONTHLY)"
    arch-chroot "${dst}" snapper --no-dbus -c root set-config "TIMELINE_LIMIT_YEARLY=2" ||
        die "Failed to configure snapper (TIMELINE_LIMIT_YEARLY)"

    # Add link to /var/run -> /run
    arch-chroot "${dst}" ln -s /run /var/run ||
        die "Failed to create the /var/run symlink"
}

finish() {
    info "--> Unmouting all partitions"

    # Same teardown as the cleanup trap; calling it here makes sure everything
    # is flushed and unmounted before we report success, and leaves the trap
    # with nothing to do.
    calaos_install_cleanup

    # The trap-side teardown never fails on purpose (it must not abort
    # mid-cleanup), so on the success path check the result explicitly rather
    # than claiming success over a filesystem that is still mounted.
    if mountpoint -q "${dst}" 2>/dev/null || mountpoint -q "${src}" 2>/dev/null; then
        die "Installation finished but some filesystems could not be unmounted"
    fi

    green "--> Installation successful, you can now reboot"
}

main() {
    parse_args "$@"
    validate_target
    detect_install_mode
    preflight_checks
    print_plan

    if [ "${dry_run}" -eq 1 ]; then
        green "--> Dry run: all checks passed, ${destination} was left untouched"
        exit 0
    fi

    wipe_partition_table
    partition_disk
    resolve_partitions
    format_partitions
    create_btrfs_layout
    mount_subvolumes
    enable_swap
    copy_rootfs
    generate_fstab
    patch_grub_scripts
    regen_initramfs
    export_container_images
    init_snapper
    install_bootloader
    configure_grub
    enable_services
    finish
}

# Only run when executed; sourcing the script (for tests) just defines the
# functions above.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
