#!/bin/bash
#
# calaos_deferred_restart - restart calaos-container once the package run that
# replaced its binary is over. Started by the package postinst in a transient
# unit: the daemon may itself drive that run through libapt, so restarting it
# from the postinst would cut the run short.

set -uo pipefail

unit=calaos-container.service
conf=/etc/calaos-container.toml
token_file=/run/calaos/calaos-ct.token
poll=5
give_up=$((SECONDS + 2 * 60 * 60))

addr=127.0.0.1
port=8000
while IFS='=' read -r key value; do
    case "$key" in
        address) addr="$value" ;;
        port) port="$value" ;;
    esac
done < <(awk -F= '
    /^[ \t]*\[/ { general = ($0 ~ /^[ \t]*\[general\]/); next }
    general && NF >= 2 {
        k = $1; v = $2; sub(/#.*/, "", v); gsub(/[ \t"]/, "", k); gsub(/[ \t"]/, "", v)
        if (k == "address" || k == "port") print k "=" v
    }' "$conf" 2>/dev/null)
case "$addr" in
    ''|0.0.0.0|::) addr=127.0.0.1 ;;
    *:*) addr="[$addr]" ;;
esac
status_url="http://$addr:$port/api/update/status"

# dpkg takes its locks with fcntl, which flock(1) cannot probe.
dpkg_busy() {
    lslocks --noheadings --raw --output PATH 2>/dev/null |
        grep -qxE '/var/lib/dpkg/lock(-frontend)?'
}

# 1.7.0 reports an empty status until its first job.
job_idle() {
    local token
    token=$(cat "$token_file" 2>/dev/null) || return 1
    curl -fsS --max-time 10 -H "Authorization: Bearer $token" "$status_url" 2>/dev/null |
        jq -e '.status == "idle" or .status == ""' >/dev/null 2>&1
}

# Prints the daemon PID while it still runs a binary that dpkg has replaced.
stale_pid() {
    local pid exe
    pid=$(systemctl show --property=MainPID --value "$unit" 2>/dev/null) || return 1
    [ "${pid:-0}" -gt 0 ] 2>/dev/null || return 1
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 1
    [[ "$exe" == *" (deleted)" ]] || return 1
    echo "$pid"
}

waiting=""
quiet=0
while :; do
    if ! pid=$(stale_pid); then
        echo "$unit runs the installed binary or is not running, nothing to do"
        exit 0
    fi

    if dpkg_busy; then
        reason="the dpkg lock"
    elif ! job_idle; then
        reason="the daemon job to finish (or the daemon to answer)"
    else
        # Two quiet polls in a row: a daemon goes idle just before it answers
        # the request that ran the upgrade.
        if [ "$quiet" -eq 1 ]; then
            echo "restarting $unit: pid $pid runs a replaced binary"
            exec systemctl restart "$unit"
        fi
        quiet=1
        sleep "$poll"
        continue
    fi
    quiet=0

    if [ "$reason" != "$waiting" ]; then
        echo "waiting for $reason"
        waiting="$reason"
    fi
    if [ "$SECONDS" -ge "$give_up" ]; then
        echo "gave up after 2 h waiting for $reason; $unit (pid $pid) still runs the old binary" >&2
        exit 1
    fi
    sleep "$poll"
done
