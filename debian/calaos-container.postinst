#!/bin/bash
set -e

unit=calaos-container.service

# SD-card images were built from a Docker export and still carry Debian's
# Docker policy-rc.d (exit 101), which blocks every package's service
# (re)start. Only that exact stub goes; any other policy-rc.d is the admin's.
remove_docker_policy_rc() {
    local f=/usr/sbin/policy-rc.d
    [ -z "${DPKG_ROOT:-}" ] && [ -f "$f" ] && [ ! -L "$f" ] || return 0
    [ -d /run/systemd/system ] || return 0
    ! systemd-detect-virt --quiet --container 2>/dev/null || return 0
    ! dpkg-query -S "$f" >/dev/null 2>&1 || return 0
    grep -q '^# For most Docker users, "apt-get install" only happens during "docker build",$' "$f" ||
        return 0
    [ "$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$f")" = "exit 101" ] || return 0
    rm -f "$f" || true
}

# Takes over the debhelper "deb-systemd-invoke start" of our unit below: its
# plain "systemctl start" blocks dpkg, and when dpkg runs from the unit's own
# ExecStartPre it waits on that very start job until TimeoutStartSec. There,
# ExecStart runs the new binary anyway.
# shellcheck disable=SC2329 # called from the debhelper section below
deb-systemd-invoke() {
    if [ "$#" -eq 2 ] && [ "$1" = start ] && [ "$2" = "$unit" ]; then
        local rc=0
        [ -z "${CALAOS_CT_STARTPRE:-}" ] || return 0
        if [ -x /usr/sbin/policy-rc.d ]; then
            /usr/sbin/policy-rc.d "$unit" start >/dev/null 2>&1 || rc=$?
            [ "$rc" -ne 101 ] || return 0
        fi
        if systemctl --quiet is-enabled "$unit" 2>/dev/null; then
            systemctl --no-block start "$unit" || true
        fi
        return 0
    fi
    command deb-systemd-invoke "$@"
}

# Must run before the debhelper start below, which consults policy-rc.d.
case "$1" in
configure) remove_docker_policy_rc || true ;;
esac

#DEBHELPER#

# The daemon may be the process driving this very upgrade (apt is linked into
# it), so it is not restarted here; a transient unit does it once dpkg and the
# daemon's job are done. Our ExecStartPre needs nothing: ExecStart follows.
# policy-rc.d is not consulted: older SD images ship Docker's exit-101 stub.
case "$1" in
configure|abort-upgrade)
    if [ -z "${CALAOS_CT_STARTPRE:-}" ] && [ -z "${DPKG_ROOT:-}" ] &&
        [ -d /run/systemd/system ]; then
        # Fails harmlessly when a waiter from an earlier run is still active.
        systemd-run --quiet --no-block --collect \
            --unit=calaos-container-deferred-restart \
            --description="Restart calaos-container after its upgrade" \
            /usr/lib/calaos-container/calaos_deferred_restart \
            >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
