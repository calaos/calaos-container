#!/bin/bash
set -e

# Versions up to 4.4.x installed the two initramfs files as directories
# (.../grub-btrfs-overlay/grub-btrfs-overlay) because the .install destination
# was the file path. dpkg cannot replace a directory by a file, so unpack would
# fail. Only a directory holding exactly the file of the same name goes; anything
# else is left alone and dpkg reports it.
remove_misplaced_dir() {
    local d="${DPKG_ROOT:-}$1/grub-btrfs-overlay"
    [ -d "$d" ] && [ ! -L "$d" ] || return 0
    if [ "$(ls -A "$d")" = "grub-btrfs-overlay" ] &&
        [ -f "$d/grub-btrfs-overlay" ] && [ ! -L "$d/grub-btrfs-overlay" ]; then
        rm -f "$d/grub-btrfs-overlay"
        rmdir "$d"
    else
        echo "calaos-container: $d is a directory with unexpected content," \
            "left in place; remove it before upgrading." >&2
    fi
}

case "$1" in
    install | upgrade)
        remove_misplaced_dir /usr/share/initramfs-tools/hooks
        remove_misplaced_dir /usr/share/initramfs-tools/scripts/local-bottom
        ;;
esac

#DEBHELPER#

exit 0
