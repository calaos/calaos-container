#!/bin/sh
# Never fails: a failing grub.d script aborts update-grub, and with it the
# kernel upgrade that ran it.

# grub-reboot into a grub-btrfs snapshot enters its menu through "configfile",
# which keeps only exported variables. Without these, that menu loses the
# chosen entry, and waits for a key on a headless box.
# The main menu countdown unsets timeout when it expires, so only a timeout
# already at 0 reaches the nested menu: the one-shot branches set it below.
# Normal boots keep the default timeout and stay interactive.
# The version line tells the package postinst that grub.cfg is up to date.
cat <<'GRUBCFG'
# calaos-snapshot-boot 4
export default
export timeout
GRUBCFG

# 00_header sets boot_once when it consumes next_entry, whether or not
# save_env succeeds: this is the one-shot mode of BIOS and of an UEFI box
# without a FAT ESP. A snapshot that dies early leaves next_entry set, so the
# 3 s window lets Escape bring the normal menu back instead of looping blind.
# GRUB scripts have no && or ||: the conditions are nested.
# boot_once is unset on a normal boot: menu and delay stay as they are.
cat <<'GRUBCFG'
if [ "${boot_once}" = "true" ]; then
  if sleep --interruptible --verbose 3; then
    set timeout=0
    export timeout
  fi
fi
GRUBCFG

# GRUB cannot rewrite a grubenv on btrfs, so a next_entry is never consumed
# and the box would boot the snapshot forever. On a FAT ESP it can: the API
# arms calaos_oneshot there, and the entry is used only once GRUB has erased
# it, so any failure boots normally.
esp=/efi
probe=${grub_probe:-grub-probe}
mountpoint -q "$esp" 2>/dev/null || exit 0
[ "$("$probe" --target=fs "$esp" 2>/dev/null)" = fat ] || exit 0
uuid=$("$probe" --target=fs_uuid "$esp" 2>/dev/null) || exit 0
case "$uuid" in
'' | *[!0-9A-Fa-f-]*) exit 0 ;;
esac

cat <<GRUBCFG
if [ "\${grub_platform}" = "efi" ]; then
  insmod part_gpt
  insmod fat
  if search --no-floppy --fs-uuid --set=calaos_esp $uuid; then
    if [ -f "(\${calaos_esp})/calaos/grubenv" ]; then
      load_env --file "(\${calaos_esp})/calaos/grubenv" calaos_oneshot
      if [ -n "\${calaos_oneshot}" ]; then
        set calaos_target="\${calaos_oneshot}"
        set calaos_oneshot=
        if save_env --file "(\${calaos_esp})/calaos/grubenv" calaos_oneshot; then
          set default="\${calaos_target}"
          set timeout=0
          export timeout
        fi
      fi
    fi
  fi
fi
GRUBCFG
exit 0
